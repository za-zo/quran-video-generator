# MongoDB Atlas connection string (server-side only; never exposed to client).
# Same value as the Python pipeline's MONGODB_URI.
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net
MONGODB_DB_NAME=quran_video_generator

# Optional: GitHub repo slug (owner/repo) used to construct Actions run URLs
# on the execution detail page. Leave blank to hide the "View run on GitHub"
# link.
GITHUB_REPO=
