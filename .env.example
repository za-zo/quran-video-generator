# === Quran Video Generator – environment example ===
# Copy to .env and adjust as needed. All values can also be set in config.yaml.

DB_PATH=./data/app.db
LOG_LEVEL=INFO

# Clip generation
CLIP_DURATION=60
CLIPS_PER_AUDIO=5

# Output video technical params
RESOLUTION=1080x1920
FPS=30
VIDEO_CODEC=libx264
AUDIO_CODEC=aac

# Paths
OUTPUT_DIR=./output
TEMP_DIR=./temp

# Selection behaviour
CATEGORY_COOLDOWN=3
ALLOW_VIDEO_REUSE_WITHIN_JOB=true
