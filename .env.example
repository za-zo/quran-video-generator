# === Quran Video Generator – environment example ===
# Copy to .env and adjust. All values can also be set in config.yaml.
# When running in GitHub Actions, set these as repository secrets – never
# commit the real .env file.

# --- Cloud infrastructure (REQUIRED for generate / stats / init-db) ---
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net
MONGODB_DB_NAME=quran_video_generator
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# GitHub Actions run ID (set automatically by the workflow yml; leave empty
# when running locally – the field is just stored for traceability).
GITHUB_RUN_ID=

# --- Clip generation ---
CLIP_DURATION=60
CLIPS_PER_AUDIO=5

# --- Output video technical params ---
RESOLUTION=1080x1920
FPS=30
VIDEO_CODEC=libx264
AUDIO_CODEC=aac

# --- Paths (local-only: FFmpeg intermediates + pre-upload MP4) ---
OUTPUT_DIR=./output
TEMP_DIR=./temp

# --- Selection behaviour ---
CATEGORY_COOLDOWN=3
ALLOW_VIDEO_REUSE_WITHIN_JOB=true

# --- Logging ---
LOG_LEVEL=INFO
