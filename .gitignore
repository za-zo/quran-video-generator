# === Python ===
# Scope these generic patterns to the Python source tree only so they
# don't accidentally capture webapp/src/lib/, webapp/build/, etc.
/src/**/__pycache__/
/src/**/*.py[cod]
/src/**/*$py.class
/src/**/*.so
/src/**/.Python
/src/**/build/
/src/**/develop-eggs/
/src/**/dist/
/src/**/downloads/
/src/**/eggs/
/src/**/.eggs/
/src/**/lib/
/src/**/lib64/
/src/**/parts/
/src/**/sdist/
/src/**/var/
/src/**/wheels/
/src/**/*.egg-info/
/src/**/.installed.cfg
/src/**/*.egg
/src/**/MANIFEST
# Allow root-level Python scripts (main.py) and tests.
__pycache__/
*.py[cod]
*$py.class

# === Virtual environments ===
venv/
.venv/
env/
ENV/

# === Project runtime artefacts ===
# Track the folders via .gitkeep but ignore their contents.
temp/*
!temp/.gitkeep
output/*
!output/.gitkeep
logs/*
!logs/.gitkeep
data/*
!data/.gitkeep
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# === Input media (user-supplied; do not commit) ===
# Keep folder structure via .gitkeep files but ignore all actual media.
audios/*
!audios/.gitkeep
videos/**/*
!videos/.gitkeep
!videos/*/
!videos/*/.gitkeep

# === Secrets / local config ===
.env
config.yaml

# === IDE / OS ===
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# === Test artefacts ===
.pytest_cache/
.coverage
htmlcov/
.tox/

# === Webapp (Next.js) ===
webapp/node_modules/
webapp/.next/
webapp/out/
webapp/build/
webapp/dist/
webapp/.env
webapp/.env.local
webapp/.env.*.local
webapp/*.tsbuildinfo
webapp/npm-debug.log*
