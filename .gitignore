# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# === Virtual environments ===
venv/
.venv/
env/
ENV/

# === Project runtime artefacts ===
# Track the folders via .gitkeep but ignore their contents.
temp/*
!temp/.gitkeep
output/*
!output/.gitkeep
logs/*
!logs/.gitkeep
data/*
!data/.gitkeep
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# === Input media (user-supplied; do not commit) ===
# Keep folder structure via .gitkeep files but ignore all actual media.
audios/*
!audios/.gitkeep
videos/**/*
!videos/.gitkeep
!videos/*/
!videos/*/.gitkeep

# === Secrets / local config ===
.env
config.yaml

# === IDE / OS ===
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# === Test artefacts ===
.pytest_cache/
.coverage
htmlcov/
.tox/
